# VS Code Container — Environment Variables
# Copy this file to .env and fill in your paths before using docker-compose.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual paths
#   podman-compose up vscode-session-1

# ── Session 1 ────────────────────────────────────────────────────────────────
# Absolute path to the folder you want to open as your workspace in session 1
WORKSPACE_PATH_SESSION_1=/path/to/your/project

# Absolute path to your git worktrees directory for session 1 (can be same as workspace)
WORKTREES_PATH_SESSION_1=/path/to/your/worktrees

# HTTPS port session 1 will listen on (default: 8443 for compose, 8550 for launcher.sh)
PORT_SESSION_1=8443

# ── Session 2 ────────────────────────────────────────────────────────────────
WORKSPACE_PATH_SESSION_2=/path/to/another/project
WORKTREES_PATH_SESSION_2=/path/to/another/worktrees
PORT_SESSION_2=8444

# ── Session 3 ────────────────────────────────────────────────────────────────
WORKSPACE_PATH_SESSION_3=/path/to/third/project
WORKTREES_PATH_SESSION_3=/path/to/third/worktrees
PORT_SESSION_3=8445

# ── Container Runtime ─────────────────────────────────────────────────────────
# Set to "podman" or "docker" depending on what you have installed
CONTAINER_RUNTIME=podman
CONTAINER_SOCKET=/run/podman/podman.sock

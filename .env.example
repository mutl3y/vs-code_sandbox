# VS Code Container Agent Environment Configuration

# Session passwords (default: dev-session-N)
VSCODE_PASSWORD_SESSION_1=dev-session-1
VSCODE_PASSWORD_SESSION_2=dev-session-2
VSCODE_PASSWORD_SESSION_3=dev-session-3

# Workspace paths (customize for your project)
# These are host paths that get mounted into containers
WORKSPACE_1=/path/to/workspace-1
WORKSPACE_2=/path/to/workspace-2
WORKSPACE_3=/path/to/workspace-3

# Worktree paths (for git operations)
WORKTREES_1=/path/to/worktrees-1
WORKTREES_2=/path/to/worktrees-2
WORKTREES_3=/path/to/worktrees-3

# Container runtime (podman or docker)
CONTAINER_RUNTIME=podman

# Container socket (podman or docker)
# For podman rootless: /run/user/1000/podman/podman.sock (or $UID)
# For podman rootful: /run/podman/podman.sock
# For docker: /var/run/docker.sock
CONTAINER_SOCKET=/run/podman/podman.sock

# Resource limits per container
CPU_LIMIT=4
MEMORY_LIMIT=4G

# Node/Python environment
NODE_ENV=production
PYTHONUNBUFFERED=1

# Logging
LOG_LEVEL=info
